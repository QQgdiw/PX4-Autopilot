#!/bin/sh
#
# @name Hybrid (Quad-Rover) Apps
# @description Starts the combined multicopter and rover control apps.
#

echo "[Hybrid] Starting Quad-Rover Hybrid Control Modules..."

if param compare HYB_ACT_TYPE 1
then
	if ! hx8_uart_servo start -d /dev/ttyS3
	then
		echo "ERROR [Hybrid] HX8 UART servo unavailable; transformation disabled"
	fi
fi

# Board and external sensors have already been started by rcS before vehicle setup.
# CAN ownership parameters are applied at boot; change them only before a reboot.
if param greater -s M2K_EN 0
then
	if ! m2006_can start
	then
		echo "ERROR [Hybrid] M2006 CAN unavailable; wheel operation disabled"
	fi
fi

# 1. MC Control (Publishing to Bypass A)
mc_rate_control start
mc_att_control start
mc_pos_control start
mc_hover_thrust_estimator start
land_detector start multicopter

if param greater -s MC_AT_EN 0
then
	mc_autotune_attitude_control start
fi

# 2. Control Allocator (Translates MC torques to PWM on Bypass A)
control_allocator start
flight_mode_manager start

# 3. Rover Control (Publishing to Bypass B)
rover_pos_control start
rover_differential start

# 4. Custom Hybrid Arbiter (The Multiplexer/Hijacker)
hybrid_vehicle_control start

echo "[Hybrid] Core module start commands completed; check errors above."
